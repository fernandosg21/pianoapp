# Copie para .env e ajuste se quiser. Todos os valores têm default sensato.

# Porta em que o app fica disponível no host.
PIANOAPP_PORT=8080

# auto | cuda | cpu. 'auto' usa a GPU quando existe e cai para CPU quando não.
PIANOAPP_DEVICE=auto

# Segundos de áudio que o Demucs processa por vez — é o que controla o pico de
# VRAM. 7.0 é conservador para 6 GB. Com 12 GB ou mais, 15.0 acelera bastante.
PIANOAPP_DEMUCS_SEGMENT=7.0

# Jobs simultâneos. Mantenha 1 com GPU: dois Demucs ao mesmo tempo estouram a VRAM.
PIANOAPP_MAX_WORKERS=1

# Limites de upload.
PIANOAPP_MAX_UPLOAD_MB=60
PIANOAPP_MAX_DURATION_S=600

# Pós-processamento da redução pianística.
PIANOAPP_MIN_NOTE_MS=60
PIANOAPP_MAX_POLYPHONY=8

# Limiar da triagem: acima disto o áudio é tratado como mixagem densa.
PIANOAPP_PERCUSSIVE_THRESHOLD=0.42
